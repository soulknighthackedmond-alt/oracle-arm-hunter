# ---------------------------------------------------------------------------
# oracle-arm-hunter - copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- OCI API credentials ---------------------------------------------------
# Identity > Users > <you> > API keys > Add API key. Keep the .pem it hands you.
OCI_USER_OCID=ocid1.user.oc1..aaaa...
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaa...
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
OCI_REGION=ap-singapore-1

# Give the private key as base64 - single line, so it survives being pasted
# into a Coolify env var (a raw PEM's newlines do not).
#   Linux/macOS:  base64 -w0 oci_api_key.pem
#   PowerShell:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("oci_api_key.pem"))
OCI_KEY_B64=
# ...or mount the file instead and point at it:
# OCI_KEY_FILE=/secrets/oci_api_key.pem

# --- where it lands --------------------------------------------------------
# Leave blank to use the tenancy root compartment.
OCI_COMPARTMENT_ID=
# Leave blank and the script picks the first public subnet it finds.
OCI_SUBNET_ID=
# Leave blank and the script picks the newest Ubuntu aarch64 image.
OCI_IMAGE_ID=
# Blank = every availability domain in the region. Listing several multiplies
# your chances; check the AD names with `python hunter.py --check`.
OCI_AVAILABILITY_DOMAINS=

# --- what it asks for ------------------------------------------------------
# Always Free Ampere A1 was halved to 2 OCPU / 12 GB on 2026-06-15.
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=2
OCI_MEMORY_GB=12
OCI_BOOT_VOLUME_GB=50
OCI_ASSIGN_PUBLIC_IP=true
INSTANCE_NAME=arm-hunter

# The PUBLIC key you will SSH in with. Paste the whole "ssh-ed25519 AAAA... " line.
SSH_PUBLIC_KEY=
# ...or a path to the .pub file inside the container.
# SSH_PUBLIC_KEY_FILE=/secrets/id_ed25519.pub

# --- pacing ----------------------------------------------------------------
# Minimum enforced by the script is 60s. Slower is kinder to your account.
RETRY_INTERVAL=300
RETRY_JITTER=90
ROUNDS_BEFORE_COOLDOWN=12
COOLDOWN_SECONDS=1200
HEARTBEAT_HOURS=12
NOTIFY_EVERY_ROUND=false
USE_CAPACITY_REPORT=true
RETRY_ON_LIMIT_EXCEEDED=false
DRY_RUN=false

# --- Telegram --------------------------------------------------------------
# Talk to @BotFather -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=
# Message your new bot once, then read the chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# --- misc ------------------------------------------------------------------
STATE_DIR=/data
LOG_LEVEL=INFO
